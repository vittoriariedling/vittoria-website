# Copy to .env and fill in. Never commit .env.

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# ── JWT ───────────────────────────────────────────────────────────────
# Two DIFFERENT secrets, each 86+ chars. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ── HTTP ──────────────────────────────────────────────────────────────
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=true
# Frontend URL, used to build invite and password-reset links.
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_HOURS=24

# ── Object storage (S3-compatible) ───────────────────────────────────
# Dev: the local SeaweedFS container (endpoints are set in compose.override.yaml).
# Prod: Cloudflare R2 (S3_REGION=auto; endpoint URLs from the R2 dashboard).
S3_BUCKET=media
S3_REGION=us-east-1
S3_ACCESS_KEY=dev-access-key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
S3_SECRET_KEY=
