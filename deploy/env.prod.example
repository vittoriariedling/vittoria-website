# Production .env. On the server: cp deploy/env.prod.example .env, then fill in.
# Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Domain and HTTPS ─────────────────────────────────────────────────
DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# ── JWT: two DIFFERENT secrets, 86+ chars each ───────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── HTTP: must match DOMAIN ──────────────────────────────────────────
CORS_ORIGINS=["https://example.com"]
PUBLIC_BASE_URL=https://example.com
COOKIE_SECURE=true

# ── Photos: Cloudflare R2 ────────────────────────────────────────────
S3_BUCKET=media
S3_REGION=auto
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Where browsers fetch signed photo URLs from (same as the endpoint unless
# you've set up a custom domain for the bucket).
S3_PUBLIC_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
