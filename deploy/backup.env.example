# Copy to deploy/backup.env on the server (gitignored) and fill in.

# A SEPARATE private R2 bucket for backups, not the photos bucket.
BACKUP_BUCKET=backups
# Delete uploaded backups older than this many days.
KEEP_DAYS=30

# rclone settings for R2. Create an R2 API token with "Object Read & Write"
# limited to the backup bucket only.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Bucket-scoped tokens can't check/create buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Optional but recommended: encrypt backups with age. Dumps contain emails,
# password hashes and login IPs. Generate a key pair ON YOUR OWN COMPUTER
# (`age-keygen -o backup-key.txt`), keep the private key off the server, and
# put the public key (age1...) here.
AGE_RECIPIENT=
